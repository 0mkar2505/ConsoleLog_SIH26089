# ==============================================================================
# SevaSetu Environment Configuration Template (.env.example)
# Copy this file to .env for local configuration: cp .env.example .env
# Never commit real credentials or actual .env files to Git.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME=SevaSetu

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=True

# SQLite Database URL (Relative to backend/ directory)
DATABASE_URL=sqlite:///./sevasetu.db

# JWT Security
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dashboard Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Mobile Configuration
FLUTTER_API_BASE_URL=http://10.0.2.2:8000/api
FLUTTER_WS_BASE_URL=ws://10.0.2.2:8000/ws
